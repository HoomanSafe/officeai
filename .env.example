# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Point Vercel frontend to a dedicated Linux VPS backend
# VITE_API_BASE_URL="https://api.your-vps-domain.com"
# VITE_WS_URL="wss://api.your-vps-domain.com/ws"

# Optional AI Providers (not required; Gemini runs cleanly as primary)
# ANTHROPIC_API_KEY=""
# OLLAMA_BASE_URL="http://localhost:11434"

# Binance USD-M Futures:
# NOTE: Phase 3 public market data (candles, mark price, funding, OI, order book) needs ZERO API keys!
# Your Binance API Key/Secret below is ONLY needed starting Phase 5 for private Testnet/Live execution:
# BINANCE_TESTNET="true"
# BINANCE_API_KEY=""
# BINANCE_API_SECRET=""

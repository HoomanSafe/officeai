APP_NAME=NEON AI TRADING HQ
APP_ENV=development
TRADING_MODE=DEMO
LIVE_TRADING_ENABLED=false

# PostgreSQL & Redis (Docker Compose defaults)
DATABASE_URL=postgresql+asyncpg://neon_hq:change_me_in_prod@postgres:5432/neon_trading_hq
REDIS_URL=redis://redis:6379/0

# Binance USD-M Futures (Configure separately for Testnet vs Live)
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# AI Providers (Configure only on backend server)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
